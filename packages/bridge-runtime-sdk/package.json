{
  "name": "@wecode/bridge-runtime-sdk",
  "version": "1.0.6",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node ./scripts/build.mjs",
    "build:dev": "BRIDGE_RUNTIME_SDK_BUILD_MODE=dev BRIDGE_RUNTIME_SDK_MINIFY=0 node ./scripts/build.mjs",
    "typecheck": "pnpm exec tsc -p ./tsconfig.json",
    "pack:check": "node ./scripts/check-pack.mjs",
    "prepack": "node ./scripts/prepare-publish-manifest.mjs",
    "prepublishOnly": "pnpm run verify:release",
    "postpack": "node ./scripts/restore-publish-manifest.mjs",
    "test": "node ./scripts/test.mjs",
    "test:case": "node ./scripts/test.mjs --test-name-pattern",
    "test:unit": "node ./scripts/test.mjs \"tests/unit/**/*.test.ts\"",
    "coverage:unit": "BRIDGE_RUNTIME_SDK_TEST_COVERAGE=1 node ./scripts/test.mjs \"tests/unit/**/*.test.ts\"",
    "verify:core": "pnpm run build && pnpm run typecheck && pnpm test && pnpm run pack:check -- --skip-build",
    "verify:release": "pnpm run verify:core"
  },
  "devDependencies": {
    "@agent-plugin/gateway-client": "workspace:*",
    "@agent-plugin/gateway-schema": "workspace:*",
    "@wecode/skill-qrcode-auth": "workspace:*",
    "@types/node": "22.19.17",
    "dts-bundle-generator": "9.5.0",
    "esbuild": "^0.27.4",
    "typescript": "^5.9.3"
  }
}
